-void StreamPlayer::StreamPlay(AddonHandler *h) {
+// Kodi timestamps are microseconds; PES and the PCR base use 90 kHz ticks.
+static void setTimestamps(mpegts::EsFrame &frame, const DEMUX_PACKET &packet, double &nextDts,
+                          int64_t presentationDelay, bool video) {
+    auto valid = [](double ts) {
+        return std::isfinite(ts) && ts != static_cast<double>(AV_NOPTS_VALUE) &&
+               ts != static_cast<double>(static_cast<int64_t>(STREAM_NOPTS_VALUE));
+    };
+    double dts = valid(packet.dts) ? packet.dts : valid(packet.pts) ? packet.pts : nextDts;
+    double pts = valid(packet.pts) ? packet.pts : dts;
+    nextDts = dts + (packet.duration > 0 ? packet.duration : 0);
+
+    constexpr uint64_t mask = (uint64_t{1} << 33) - 1;
+    constexpr int64_t decoderLead = 9000;  // 100 ms between PCR and decoding.
+    int64_t decodeTicks = std::llround(dts * 90000.0 / STREAM_TIME_BASE);
+    frame.mPcr = decodeTicks & mask;
+    frame.mDts = (decodeTicks + decoderLead + (video ? 0 : presentationDelay)) & mask;
+    frame.mPts = (std::llround(pts * 90000.0 / STREAM_TIME_BASE) + decoderLead + presentationDelay) & mask;
+}
