#!/usr/bin/env bash
set -euo pipefail

pids=()
enigma_pid=
cleanup() {
    if [[ -n "$enigma_pid" ]]; then
        kill "$enigma_pid" 2>/dev/null || true
        wait "$enigma_pid" 2>/dev/null || true
    fi
    kill "${pids[@]}" 2>/dev/null || true
    wait 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM

Xvfb "$DISPLAY" -screen 0 1280x720x24 -nolisten tcp &
pids+=("$!")
for ((attempt = 0; attempt < 50; attempt++)); do
    if xdpyinfo >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
done
xdpyinfo >/dev/null

x11vnc -display "$DISPLAY" -listen 127.0.0.1 -rfbport 5900 -forever -shared -nopw -noxdamage -quiet &
pids+=("$!")
/usr/bin/python3.12 /usr/bin/websockify --web /usr/share/novnc 6080 127.0.0.1:5900 &
pids+=("$!")

enigma2 &
enigma_pid=$!
wait -n "${pids[@]}" "$enigma_pid"
